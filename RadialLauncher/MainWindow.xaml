<Window x:Class="RadialLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        xmlns:services="clr-namespace:RadialLauncher.Services"
        Title="RadialLauncher"
        Width="0" Height="0"
        Left="-4000" Top="-4000"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Visibility="Hidden">

    <Window.Resources>
    </Window.Resources>

    <Grid>
        <!-- IconSource 在代码里设置：H.NotifyIcon 不接受 DrawingImage，只能给位图 -->
        <tb:TaskbarIcon x:Name="Tray"
                        ToolTipText="{Binding [Tray_Tooltip], Source={x:Static services:Loc.Instance}}"
                        NoLeftClickDelay="True"
                        TrayMouseDoubleClick="OnTrayDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{Binding [Tray_OpenSettings], Source={x:Static services:Loc.Instance}}"
                              Click="OpenSettings" FontWeight="Bold"/>
                    <MenuItem Header="{Binding [Tray_Test], Source={x:Static services:Loc.Instance}}"
                              Click="TestWheelClick"/>
                    <MenuItem Header="{Binding [Tray_Reload], Source={x:Static services:Loc.Instance}}"
                              Click="ReloadConfig"/>
                    <MenuItem Header="{Binding [Tray_Log], Source={x:Static services:Loc.Instance}}"
                              Click="OpenLog"/>
                    <Separator/>
                    <MenuItem Header="{Binding [Tray_Exit], Source={x:Static services:Loc.Instance}}"
                              Click="ExitApp"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
