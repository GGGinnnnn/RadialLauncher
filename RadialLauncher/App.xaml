<Application x:Class="RadialLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 调色板（浅色）。深色模式由 ThemeManager 整份换成 Palette.Dark.xaml。
                     必须排在 Theme.xaml / Controls.xaml 之前：后两者用 DynamicResource
                     引用这里的画刷，运行时替换这一项即可全界面换肤。 -->
                <ResourceDictionary Source="Styles/Palette.Light.xaml"/>
                <!-- 结构：字体 / 字号 / 文字与卡片样式 -->
                <ResourceDictionary Source="Styles/Theme.xaml"/>
                <!-- 控件外观：按钮 / 开关 / 滑条 / 卡片 / 导航 … -->
                <ResourceDictionary Source="Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
