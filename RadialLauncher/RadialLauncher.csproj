<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<RootNamespace>RadialLauncher</RootNamespace>
		<AssemblyName>RadialLauncher</AssemblyName>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>Resources\app.ico</ApplicationIcon>

		<!-- 版本：文件版本 0.2.0.0，关于页显示 v0.2 -->
		<Version>0.2.0</Version>
		<AssemblyVersion>0.2.0.0</AssemblyVersion>
		<FileVersion>0.2.0.0</FileVersion>
		<InformationalVersion>0.2</InformationalVersion>

		<AssemblyTitle>Radial Launcher</AssemblyTitle>
		<Product>Radial Launcher</Product>
		<Description>按住 Ctrl / Win / 鼠标中键唤出的轮盘启动器</Description>
		<Company>Radial Launcher</Company>
		<Copyright>Copyright (C) 2026</Copyright>

		<!-- 只保留中英文资源，别把一堆语言卫星程序集打进包里 -->
		<SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>

		<!-- WPF 不支持裁剪，显式关掉以免误开 -->
		<PublishTrimmed>false</PublishTrimmed>
	</PropertyGroup>

	<!-- Release：把调试符号嵌进程序集，发布目录里就不会多出 .pdb -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugType>embedded</DebugType>
		<Optimize>true</Optimize>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="H.NotifyIcon.Wpf" Version="2.1.3" />
	</ItemGroup>

</Project>
