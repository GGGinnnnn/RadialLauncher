<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         深色调色板（Windows 11 深色设置风格）
         ============================================================
         键名必须与 Palette.Light.xaml 完全一致 —— ThemeManager 会整份
         替换掉浅色那一份，少一个键就会让对应控件退回默认外观。
         强调色用 Win11 深色下的浅蓝 #60CDFF，配深色文字。
         ============================================================ -->

    <!-- ===== 强调色 ===== -->
    <Color x:Key="AccentColor">#FF60CDFF</Color>
    <Color x:Key="AccentHoverColor">#FF7AD8FF</Color>
    <Color x:Key="AccentPressedColor">#FF4CC2FF</Color>
    <Color x:Key="AccentDisabledColor">#FF4A4A4A</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentDisabledBrush" Color="{StaticResource AccentDisabledColor}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FF00131F"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#3360CDFF"/>

    <!-- ===== 背景 / 卡片 ===== -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF202020"/>
    <SolidColorBrush x:Key="WindowBackgroundTopBrush" Color="#FF1B2430"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF2B2B2B"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#FF4C4C4C"/>
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="InsetCardBackgroundBrush" Color="#FF242424"/>

    <!-- ===== 文字 ===== -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFC8C8C8"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF9A9A9A"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#FF6E6E6E"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FF00131F"/>

    <!-- ===== 控件 ===== -->
    <Color x:Key="ControlFillColor">#FF2D2D2D</Color>
    <SolidColorBrush x:Key="ControlFillBrush" Color="{StaticResource ControlFillColor}"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF4A4A4A"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FF383838"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#FF323232"/>
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="ControlStrongBorderBrush" Color="#FF9A9A9A"/>

    <!-- ===== 开关 ===== -->
    <Color x:Key="ToggleOffColor">#FF6E6E6E</Color>
    <Color x:Key="ToggleOffHoverColor">#FF8A8A8A</Color>
    <SolidColorBrush x:Key="ToggleKnobOffBrush" Color="#FFF0F0F0"/>

    <!-- ===== 滑条 ===== -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#FF5A5A5A"/>
    <SolidColorBrush x:Key="SliderTrackHoverBrush" Color="#FF6E6E6E"/>

    <!-- ===== 导航 ===== -->
    <SolidColorBrush x:Key="NavHoverBrush" Color="#FF313131"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="NavIconBrush" Color="#FFD0D0D0"/>
    <SolidColorBrush x:Key="NavIconSelectedBrush" Color="{StaticResource AccentColor}"/>

    <!-- ===== 每个页面的点缀色（深色下提亮，保证在深底上看得清）===== -->
    <SolidColorBrush x:Key="ChipBlueBrush" Color="#FF60CDFF"/>
    <SolidColorBrush x:Key="ChipMagentaBrush" Color="#FFE38FE0"/>
    <SolidColorBrush x:Key="ChipGreenBrush" Color="#FF6CCB6C"/>
    <SolidColorBrush x:Key="ChipPurpleBrush" Color="#FFB79CE8"/>
    <SolidColorBrush x:Key="ChipOrangeBrush" Color="#FFFF9A56"/>
    <SolidColorBrush x:Key="ChipTealBrush" Color="#FF4CC7C7"/>
    <SolidColorBrush x:Key="ChipGreyBrush" Color="#FFA0B0B6"/>

    <SolidColorBrush x:Key="ChipBlueSoftBrush" Color="#3360CDFF"/>
    <SolidColorBrush x:Key="ChipMagentaSoftBrush" Color="#33E38FE0"/>
    <SolidColorBrush x:Key="ChipGreenSoftBrush" Color="#336CCB6C"/>
    <SolidColorBrush x:Key="ChipPurpleSoftBrush" Color="#33B79CE8"/>
    <SolidColorBrush x:Key="ChipOrangeSoftBrush" Color="#33FF9A56"/>
    <SolidColorBrush x:Key="ChipTealSoftBrush" Color="#334CC7C7"/>
    <SolidColorBrush x:Key="ChipGreySoftBrush" Color="#33A0B0B6"/>

</ResourceDictionary>
