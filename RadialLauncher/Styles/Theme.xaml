<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================
         设计标记（照着 Windows 11 设置的样子来）
         浅色主题 · 圆角卡片 · 强调色点缀
         ============================================================ -->

    <!-- ===== 强调色（Win11 默认蓝）===== -->
    <Color x:Key="AccentColor">#FF0067C0</Color>
    <Color x:Key="AccentHoverColor">#FF1975C5</Color>
    <Color x:Key="AccentPressedColor">#FF3183CB</Color>
    <Color x:Key="AccentDisabledColor">#FFC7C7C7</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentDisabledBrush" Color="{StaticResource AccentDisabledColor}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A0067C0"/>

    <!-- ===== 背景 / 卡片 ===== -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF3F3F3"/>
    <SolidColorBrush x:Key="WindowBackgroundTopBrush" Color="#FFEDF3FB"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FFE3E3E3"/>
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#FFD0D0D0"/>
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#0F000000"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#FFE5E5E5"/>

    <!-- ===== 文字 ===== -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1B1B1B"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF5F5F5F"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF8A8A8A"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#FFA0A0A0"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFFFF"/>

    <!-- ===== 控件 ===== -->
    <Color x:Key="ControlFillColor">#FFFDFDFD</Color>
    <SolidColorBrush x:Key="ControlFillBrush" Color="{StaticResource ControlFillColor}"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FFD5D5D5"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FFF6F6F6"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="#FFF4F4F4"/>
    <SolidColorBrush x:Key="ControlStrongBorderBrush" Color="#FF8A8A8A"/>

    <!-- ===== 开关 ===== -->
    <Color x:Key="ToggleOffColor">#FF8A8A8A</Color>
    <Color x:Key="ToggleOffHoverColor">#FF6E6E6E</Color>
    <SolidColorBrush x:Key="ToggleKnobOffBrush" Color="#FFFFFFFF"/>

    <!-- ===== 滑条 ===== -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#FFBFBFBF"/>
    <SolidColorBrush x:Key="SliderTrackHoverBrush" Color="#FFA6A6A6"/>

    <!-- ===== 导航 ===== -->
    <SolidColorBrush x:Key="NavHoverBrush" Color="#FFE7E7E7"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="NavIconBrush" Color="#FF444444"/>
    <SolidColorBrush x:Key="NavIconSelectedBrush" Color="{StaticResource AccentColor}"/>

    <!-- ===== 每个页面的点缀色（让面板颜色丰富一点）===== -->
    <SolidColorBrush x:Key="ChipBlueBrush" Color="#FF0067C0"/>
    <SolidColorBrush x:Key="ChipMagentaBrush" Color="#FFC239B3"/>
    <SolidColorBrush x:Key="ChipGreenBrush" Color="#FF0F7B0F"/>
    <SolidColorBrush x:Key="ChipPurpleBrush" Color="#FF8764B8"/>
    <SolidColorBrush x:Key="ChipOrangeBrush" Color="#FFCA5010"/>
    <SolidColorBrush x:Key="ChipTealBrush" Color="#FF038387"/>
    <SolidColorBrush x:Key="ChipGreyBrush" Color="#FF69797E"/>

    <SolidColorBrush x:Key="ChipBlueSoftBrush" Color="#1F0067C0"/>
    <SolidColorBrush x:Key="ChipMagentaSoftBrush" Color="#1FC239B3"/>
    <SolidColorBrush x:Key="ChipGreenSoftBrush" Color="#1F0F7B0F"/>
    <SolidColorBrush x:Key="ChipPurpleSoftBrush" Color="#1F8764B8"/>
    <SolidColorBrush x:Key="ChipOrangeSoftBrush" Color="#1FCA5010"/>
    <SolidColorBrush x:Key="ChipTealSoftBrush" Color="#1F038387"/>
    <SolidColorBrush x:Key="ChipGreySoftBrush" Color="#1F69797E"/>

    <!-- ===== 字体 ===== -->
    <!-- 运行时由 ThemeManager 覆盖；这里给一个默认值保证 XAML 先能加载 -->
    <FontFamily x:Key="AppFontFamily">Microsoft YaHei UI, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Consolas, Cascadia Mono, Courier New</FontFamily>
    <!-- Win11 自带的图标字体，用于侧边栏图标 -->
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="BodyFontSize">14</sys:Double>
    <sys:Double x:Key="SmallFontSize">12</sys:Double>

    <!-- ============================================================
         文字样式
         ============================================================ -->

    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="PageSubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style x:Key="SectionHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="FieldLabelText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="17"/>
    </Style>

    <!-- 卡片：白底 + 圆角 + 细边 -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="InsetCardBorder" TargetType="Border">
        <Setter Property="Background" Value="#FFFAFAFA"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- 页面顶部的小色块图标（每个页面一个颜色） -->
    <Style x:Key="PageChipBorder" TargetType="Border">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{StaticResource ChipBlueSoftBrush}"/>
    </Style>

    <Style x:Key="ChipGlyphText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource ChipBlueBrush}"/>
    </Style>

</ResourceDictionary>
