<Window x:Class="RadialLauncher.Views.ScreenColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenColorPicker"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Width="176" Height="196"
        Cursor="Cross">

    <Border CornerRadius="8" Background="#F01A1A2E" BorderBrush="#88FFFFFF" BorderThickness="1" Padding="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="2" Opacity="0.6"/>
        </Border.Effect>

        <StackPanel>
            <!-- 放大镜 -->
            <Border BorderBrush="#66FFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                <Image x:Name="Magnifier" Width="120" Height="120"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>

            <!-- 当前颜色 -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="Swatch" Grid.Column="0" Width="28" Height="28" CornerRadius="4"
                        BorderBrush="#66FFFFFF" BorderThickness="1"/>
                <TextBlock x:Name="HexText" Grid.Column="1" Margin="8,0,0,0"
                           VerticalAlignment="Center" FontFamily="Consolas" FontSize="12"
                           Foreground="White" Text="#000000"/>
            </Grid>

            <TextBlock x:Name="HintText" Margin="0,6,0,0" FontSize="10"
                       Foreground="#AAFFFFFF" TextWrapping="Wrap" Width="120"/>

            <TextBlock x:Name="CoordText" Margin="0,3,0,0" FontSize="10"
                       Foreground="#88FFFFFF" FontFamily="Consolas"/>
        </StackPanel>
    </Border>
</Window>
