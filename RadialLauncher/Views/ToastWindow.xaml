<Window x:Class="RadialLauncher.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toast"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MaxWidth="420">

    <Border x:Name="Card"
            Margin="12"
            CornerRadius="10"
            Background="#F01E1E2E"
            BorderBrush="#66FFFFFF"
            BorderThickness="1"
            Padding="14,10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="2" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="IconText"
                       Grid.Column="0"
                       Text="●"
                       FontSize="18"
                       Margin="0,0,10,0"
                       VerticalAlignment="Top"
                       Foreground="#FF4A9EFF"/>

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText"
                           Text="标题"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="#FFFFFFFF"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="BodyText"
                           Text=""
                           FontSize="12"
                           Margin="0,3,0,0"
                           Foreground="#CCFFFFFF"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
