<Window x:Class="RadialLauncher.Views.WheelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RadialLauncher.Controls"
        Title="Wheel"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Width="480" Height="480">

    <Window.Resources>
        <!--
          圆形槽位。层次由 Content 负责（见 WheelPainter.BuildSlotContent：
          顶部高光 + 边缘高光 + 图标 + 名字），这里只画最底下的渐变圆底，
          外加一圈极淡的内阴影让圆底看起来是凹进去的。
        -->
        <Style x:Key="WheelButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#E62A2A3A"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- 渐变圆底（选中/未选中由代码整份换画刷；环形布局下是透明） -->
                            <Ellipse Fill="{TemplateBinding Background}"/>
                            <!-- 内阴影：贴边压暗一圈，做出凹陷层次（环形布局下厚度设 0 即可关掉） -->
                            <Ellipse Fill="Transparent"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="{TemplateBinding BorderThickness}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 根容器整体做缩放动画；IsHitTestVisible=False 让鼠标事件穿透到下面的窗口 -->
    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False" Opacity="1">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>

        <!--
          背景装饰层：外发光 / 底盘径向渐变 / 双环 / 辐条 / 中心刻度 / 中心盘，
          全部由 WheelPainter.DrawBackground 画进这个 Canvas。
          这样真实窗口与设置面板预览共用同一套绘制代码，不会各自漂移。
        -->
        <Canvas x:Name="Decor"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"/>

        <!-- 槽位本体 -->
        <controls:RadialMenu x:Name="Menu"
                             ItemCount="8"
                             Radius="144"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             IsHitTestVisible="False"/>

        <!-- 中心提示 -->
        <StackPanel x:Name="CenterPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
            <TextBlock x:Name="CenterTitle"
                       Text="松开执行"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="120"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="CenterSubtitle"
                       Text="Esc 取消"
                       TextAlignment="Center"
                       Margin="0,3,0,0"
                       Foreground="#99FFFFFF"
                       FontSize="11"/>
        </StackPanel>
    </Grid>
</Window>
